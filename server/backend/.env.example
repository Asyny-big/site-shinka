# Скопируйте этот файл в backend/.env и впишите свой ключ.
# Файл .env НЕ кладётся в архив и НЕ коммитится.

# Ключ OpenRouter (https://openrouter.ai/keys). Без него ИИ отвечает заглушкой,
# а сайт продолжает работать: фронтенд подхватывает локальный справочник.
OPENROUTER_API_KEY=

# Модель (можно несколько через запятую). По умолчанию — openrouter/free
OPENROUTER_MODEL=openrouter/free
# Резервные модели через запятую (необязательно)
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_APP_TITLE=Шиномонтаж у Дениса

# Домен сайта для CORS и заголовка HTTP-Referer
ALLOWED_ORIGIN=https://ydenisa.ru

# Порт Node-сервера (nginx проксирует /api/ сюда)
PORT=3000
